<?xml version="1.0" encoding="utf-8"?>
<!-- "Ask Tove" bar: the bar opens a new chat with the keyboard up, the mic opens live voice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/widget_ask_bar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_ask_label"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mark"
            android:tint="@color/widget_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:singleLine="true"
            android:text="@string/widget_ask_label"
            android:textColor="@color/widget_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_ask_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_circle"
        android:contentDescription="@string/widget_live_description"
        android:padding="11dp"
        android:src="@drawable/ic_call_mic"
        android:tint="@color/widget_on_tile" />
</LinearLayout>
