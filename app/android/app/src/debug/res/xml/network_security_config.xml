<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (src/debug). Allows plain HTTP to the device loopback so a
     bridge forwarded with `adb reverse tcp:8787 tcp:8787` can be reached at
     http://127.0.0.1:8787 (or any port). Everything else keeps the platform default
     (HTTPS only). Release builds do not include this file or the manifest
     attribute that points at it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
