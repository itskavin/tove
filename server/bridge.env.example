# Bridge configuration. Copy to bridge.env, fill in the keys, and keep the file private (chmod 600).
# Lines left commented out use the default shown. Never commit the filled-in file.
# Generate a key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Keys (set at least one; each must be 24+ characters) -------------------------------------------------------
# The app's key. Every /api/* route needs "Authorization: Bearer <LIVE_PAGE_KEY>". Paste it into the app once.
LIVE_PAGE_KEY=

# Optional: lets Hermes' scheduled jobs on this host post the assistant's own messages (POST /api/notify, loopback only).
# At least 24 characters, different from LIVE_PAGE_KEY. Unset = the route is off.
#TOVE_NOTIFY_KEY=
# One-time pairing codes for the app (API.md "Pairing"; made by tove_pair.py or the tove-setup Hermes skill). Holds
# hashes only. Default <data>/pairing.json.
#TOVE_PAIR_FILE=<data>/pairing.json
# Optional: key for the Open WebUI Realtime route /v1/realtime. Leave empty to turn that route off.
BRIDGE_API_KEY=

# ---- Network -----------------------------------------------------------------------------------------------------
# Address and port the bridge listens on. Keep 127.0.0.1 unless a reverse proxy or container network needs otherwise.
# The Docker image and compose example set 0.0.0.0 inside the container.
#BRIDGE_HOST=127.0.0.1
#BRIDGE_PORT=8787

# ---- Hermes Agent ------------------------------------------------------------------------------------------------
# Hermes' OpenAI-compatible API server (Hermes' own default port is 8642). From a container on the same host use
# http://host.docker.internal:8642/v1 (see compose.example.yaml).
#HERMES_API_URL=http://127.0.0.1:8642/v1
# Hermes' API_SERVER_KEY. Without it, chat and delegated voice tasks are off.
HERMES_API_KEY=
# Model name sent to Hermes.
#HERMES_MODEL=hermes-agent

# ---- Storage -----------------------------------------------------------------------------------------------------
# One directory for everything the bridge keeps. The paths below default to files inside it (written <data> here;
# env files do not expand variables, so write full paths if you set them).
#BRIDGE_DATA_DIR=~/.local/share/gpt-live-bridge
# Chat history (SQLite, created with mode 600).
#LIVE_CHAT_DB=<data>/chats.sqlite
# Built Flutter web app served at /app/, and the Android APK served at /downloads/hermes-live.apk (both optional).
#LIVE_APP_DIR=<data>/web
#LIVE_APK_PATH=<data>/hermes-live.apk

# ---- GPT-Live through the official Codex CLI ------------------------------------------------------------------------
# The codex binary (default: "codex" from PATH). The bridge runs "codex app-server" with your ChatGPT login.
#CODEX_BIN=/usr/local/bin/codex
# Codex's own home for the bridge's login. Use a separate one: refresh tokens are single-use, so sharing a login with
# a Codex CLI you also use by hand logs one of them out. Log in with: CODEX_HOME=<this dir> codex login --device-auth
#CODEX_HOME=<data>/codex-home
# Scratch directory codex starts in (read-only sandbox; nothing is written there by design).
#BRIDGE_WORKDIR=<data>/work
# Default GPT-Live voice: arbor, aube, breeze, bubbie, cove, ember, juniper, maple, sol, spruce or vale.
#GPT_LIVE_VOICE=cove
# The name the voice uses for itself. Match the name your Hermes Agent goes by.
#ASSISTANT_NAME=Hermes

# ---- GPT-Live through the OpenAI Live API (your own API key, $0.05 per voice minute) -------------------------------
# Which backend /api/session uses: auto (codex when CODEX_HOME holds a login, else openai when OPENAI_API_KEY is set),
# codex, or openai. Open WebUI's /v1/realtime always uses codex. SELF-HOSTING.md compares the two.
#LIVE_BACKEND=auto
# A project API key with GPT-Live access. Use a dedicated project with its own spend limit. Stays on this server.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_LIVE_MODEL=gpt-live-1
# Default voice for this backend (marin, quartz, ripple, vesper, willow, stone, gleam, meridian, bossa, tempo,
# beacon, delta, cinder, nuri, juni, flitz, brise, sillage, nira, harema, shida, noeul). Codex voice names that the
# app sends are mapped to a similar one.
#OPENAI_LIVE_VOICE=marin
# Cost control: each call ends after this many minutes, and all calls together may use this many minutes per local
# day (0 = no daily budget). 60 minutes is about $3 a day. Also set a spend limit on the OpenAI project.
#OPENAI_MAX_CALL_MINUTES=30
#OPENAI_DAILY_MINUTES=60
# Where the day's usage is kept (default <data>/openai-usage.json).
#OPENAI_USAGE_FILE=<data>/openai-usage.json

# ---- Limits ------------------------------------------------------------------------------------------------------
# Open WebUI Realtime calls at once, and the maximum length in seconds of every call (app calls included; the openai
# backend also applies OPENAI_MAX_CALL_MINUTES, whichever is shorter).
#BRIDGE_MAX_CALLS=1
#BRIDGE_CALL_SECONDS=3300
# Delegated Hermes tasks running at once per live call.
#LIVE_MAX_JOBS=2
# Chat replies being written at once (whether or not a client is connected). Extra requests get 429 busy.
#LIVE_MAX_CHATS=2

# ---- Chat ----------------------------------------------------------------------------------------------------------
# Titles: "auto" (default: "model" when TITLE_API_KEY is set, else "simple"), "simple" (the first message without
# "hi"/"can you", no model call), "model" (one small call to an OpenAI-compatible endpoint for a 3–4 word title, about
# 100 tokens per new chat) or "hermes" (one extra Hermes call that runs the whole agent, about 12,700 prompt tokens).
#LIVE_TITLES=auto
# The "model" title endpoint: an OpenAI-compatible /v1 (for example a local CLIProxyAPI), a client key, and a small model.
#TITLE_API_URL=http://127.0.0.1:8317/v1
#TITLE_API_KEY=
#TITLE_MODEL=gpt-6-luna
# OpenAI's priority ("fast") tier for the title call (default priority; off sends none). It uses more of the plan's quota.
#TITLE_SERVICE_TIER=priority
# Reply effort also picks the service tier: Instant uses Hermes' default (fast-tier) provider, while Medium and High
# name this Hermes provider, which runs the default tier (API.md "Reply effort"). off = every reply on the default provider.
#HERMES_STANDARD_PROVIDER=cliproxy-standard
# Effort for a chat reply sent without one (instant, medium or high; anything else = Hermes' own defaults).
#CHAT_DEFAULT_EFFORT=medium
# Seconds a finished reply stays resumable from memory; after that, resume answers from the saved message.
#LIVE_STREAM_KEEP_S=300
# Events kept per reply for exact replay (16 or more). Older ones are replaced by a "snapshot" event on resume.
#LIVE_STREAM_BUFFER=10000
# What a dropped /api/chat connection does: "continue" (the reply goes on; stop it with POST /api/chat/{id}/stop)
# or "cancel" (the old behaviour: a disconnect stops the reply).
#LIVE_STREAM_DISCONNECT=continue

# ---- Attachments (API.md "Attachments") --------------------------------------------------------------------------
#LIVE_UPLOADS=true
# Where uploads are stored (one file per sha256, mode 600).
#LIVE_UPLOAD_DIR=<data>/uploads
#LIVE_UPLOAD_IMAGE_MB=10
#LIVE_UPLOAD_FILE_MB=25
#LIVE_UPLOAD_CONVERSATION_MB=200
#LIVE_UPLOAD_TOTAL_MB=2048
#LIVE_UPLOAD_MAX_ITEMS=4
# Uploads that no message uses are deleted after this many hours.
#LIVE_UPLOAD_UNUSED_HOURS=24
# true: images go to Hermes as image_url parts (its model must accept images). false: images are treated as documents.
#LIVE_VISION=true
# Documents are copied here for Hermes' tools to read (leave empty to accept images only). Make it a setgid directory
# owned by the bridge's user with Hermes' group, e.g.:  install -d -o <bridge user> -g <hermes group> -m 2750 <dir>
#HERMES_UPLOAD_DIR=
# The same directory as Hermes sees it, if that path differs (for example inside Hermes' container).
#HERMES_UPLOAD_PATH=

# ---- Chat extras ---------------------------------------------------------------------------------------------------
# web_search flag on /api/chat: auto (on when Hermes' /v1/toolsets shows its web toolset enabled), true or false.
#LIVE_WEB_SEARCH=auto
# Prompt for the Hermes app (hermes-ui blocks, GFM tables), sent as a system message only when /api/chat carries
# "ui": 1 (or the X-Hermes-UI header). Unset: <data>/hermes-ui-prompt.md if it exists, else the hermes-ui-prompt.md
# shipped beside the bridge. "off" sends nothing.
#LIVE_UI_PROMPT_FILE=
# GET /api/link-preview, /api/favicon and /api/image (the bridge fetches public pages and pictures for link cards and
# reply images; private addresses are always refused). Pictures are cached in <data>/image-cache (256 MB at most).
#LIVE_LINK_PREVIEW=true

# ---- Usage limits (GET /api/usage/limits) ---------------------------------------------------------------------------
# CLIProxyAPI's management API: its base URL and the management secret (the panel password; it never leaves the bridge).
# Without the secret, only the bridge's own ChatGPT login (CODEX_HOME) is shown.
#CLIPROXY_URL=http://127.0.0.1:8317
#CLIPROXY_MANAGEMENT_KEY=
# Also show the quota of the bridge's own ChatGPT login (GPT-Live), read with its saved token.
#USAGE_LIVE_LOGIN=true

# ---- Push notifications (UnifiedPush; see SELF-HOSTING.md for ntfy) ---------------------------------------------
# Turn the push routes and notifications on or off.
#PUSH_ENABLED=true
# false: pushes carry only ids and status, never the chat title or reply text (use this with a public distributor).
#PUSH_PREVIEWS=true
# Devices that may register, and pushes per device per minute (extra pushes are dropped).
#PUSH_MAX_DEVICES=10
#PUSH_RATE_PER_MIN=20

# ---- The app's own notifications and live tasks in the chat (API.md "Events", "Live tasks in the chat") --------
# GET /api/events: the app holds this stream open itself (no distributor app). Seconds between heartbeats; keep it
# under the shortest idle timeout on the way (Cloudflare closes a silent proxied stream after 100 s).
#LIVE_EVENTS_HEARTBEAT_S=80
# Events kept for resume and polling (also at most 7 days). Sync events (chat changes) make about five per typed turn.
#LIVE_EVENTS_KEEP=2000
# Tasks of a call linked to a chat get the app's UI prompt (blocks in the answer; ~3,700 more prompt tokens a call).
#LIVE_TASK_UI=true
# Replies the user reports from the app ("Report reply"), one JSON line each (API.md "Reports"). Mode 600.
#LIVE_REPORTS_FILE=~/.local/share/gpt-live-bridge/reports.jsonl

# Dictation on the server: POST /api/transcribe (API.md "Transcription"). Unset STT_REALTIME_URL turns it off.
# An OpenAI Realtime-compatible websocket, e.g. CLIProxyAPI: ws://127.0.0.1:8317/v1/realtime with one of its client keys.
#STT_REALTIME_URL=
#STT_API_KEY=
#STT_MODEL=gpt-4o-transcribe
#STT_SESSION_MODEL=gpt-realtime-2.1-mini
#STT_MAX_SECONDS=120
#STT_MAX_CONCURRENT=3
#STT_TIMEOUT_SECONDS=45
